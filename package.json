{
  "name": "vscode-expo-bridge",
  "displayName": "Expo Bridge",
  "description": "Build, install, launch, and screenshot an Expo iOS app on the Mac host from a devcontainer.",
  "publisher": "plume-works",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plume-works/vscode-expo-bridge.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "package": "bun run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.6.2",
    "typescript": "5.9.3"
  }
}
