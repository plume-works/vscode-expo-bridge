{
  "name": "vscode-expo-bridge",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plume-works/vscode-expo-bridge.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "package": "bun run --filter '*' package",
    "bump": "bun packages/release/src/bump.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.6.2",
    "prettier": "3.8.4",
    "typescript": "5.9.3"
  }
}
