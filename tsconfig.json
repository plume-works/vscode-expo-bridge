{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "vscode"],
    "paths": {
      "@plume-works/expo-bridge-protocol": ["./packages/protocol/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/bin", "packages/*/test"]
}
